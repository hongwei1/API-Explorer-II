{
  "extends": "@vue/tsconfig/tsconfig.web.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "test/integration.test.ts", "playwright.config.ts"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "esModuleInterop": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    // @vue/tsconfig's base config sets preserveValueImports/importsNotUsedAsValues,
    // which vue-tsc 2.2.12's checker treats as deprecated (TS5101) and errors on -
    // this silences that diagnostic without changing any actual type checking.
    "ignoreDeprecations": "5.0"
  }
}
